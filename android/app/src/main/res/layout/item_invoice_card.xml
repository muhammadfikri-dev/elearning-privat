<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/border_glass"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_inv_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INV-2026-0901"
                android:textColor="@color/primary_brand_light"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_inv_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menunggu Verifikasi"
                android:textColor="@color/accent_amber"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/ic_launcher_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_inv_student"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kevin Pratama"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_inv_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paket Intensif SNBT 1-on-1 (12 Sesi)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_dark"
            android:padding="10dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Tagihan:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_inv_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 1.800.000"
                android:textColor="@color/accent_emerald"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_action_inv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kirim Pengingat WhatsApp"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_emerald"
            app:icon="@drawable/ic_chat"
            app:cornerRadius="12dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
