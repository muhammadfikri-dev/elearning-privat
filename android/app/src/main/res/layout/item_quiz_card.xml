<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/accent_purple"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_quiz_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Matematika"
                android:textColor="@color/accent_purple"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/ic_launcher_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_quiz_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏱️ 15 Menit"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_quiz_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kuis Evaluasi 01: Turunan &amp; Aplikasi Maksimum"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg_dark"
            android:padding="8dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_quiz_pass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Passing Grade: 75"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_quiz_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nilai: 90 / 100"
                android:textColor="@color/accent_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_quiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mulai Kerjakan Kuis"
            android:textColor="@color/white"
            app:backgroundTint="@color/accent_purple"
            app:icon="@drawable/ic_quiz"
            app:cornerRadius="12dp"
            android:layout_marginTop="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
